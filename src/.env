# Database Configuration
DB_PATH=./data/bank_data.db

# Data Generation Counts
NUM_CLIENTS=100000
NUM_CASA_TRANSACTIONS=500000
NUM_CC_TRANSACTIONS=30000
NUM_CLIENT_RELATIONS=10000
NUM_BUSINESSES=1000
NUM_BUSINESS_RELATIONS=100

# CASA Account Configuration
CASA_ACCOUNT_PROBABILITY=0.7

# Credit Card Account Configuration
CC_ACCOUNT_PROBABILITY=0.3

# States (comma-separated)
STATES=Texas,California,New York,Florida

# Client Relation Types (comma-separated)
RELATION_TYPES=family/partner,business relation

# Business Relation Types (comma-separated)
BUSINESS_RELATION_TYPES=customer,supplier,owner

# Credit Card Categories (comma-separated)
CC_CATEGORIES=groceries,travel,entertainment,utilities

# SCHEMA
SCHEMA_PATH=./data/schema.json

# GRAPH
GRAPH_NAME=schema_graph
FALKOR_HOST=localhost
FALKOR_PORT=6379

# OLLAMA
OLLAMA_HOST=http://localhost:11434
